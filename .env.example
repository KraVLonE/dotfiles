# Secrets template
# Copy or edit this to ~/.config/dotfiles/secrets.env
# Permissions should be: chmod 600 ~/.config/dotfiles/secrets.env

# NordVPN credentials (used by vpntoggle.sh)
NORDVPN_USER="your-email@example.com"
NORDVPN_PASS="your-password"

# Aternos credentials (used by openaternos.py)
ATERNOS_USER="your-username"
ATERNOS_PASS="your-password"

